# Пароль входа в веб-интерфейс
APP_PASSWORD=change-me
# Порт на хосте
APP_PORT=9009

# Папка на хосте с пулами: <DEPLOY_FOLDER>/<имя пула>/docker-compose.yml
DEPLOY_FOLDER=/opt/deploy
# Папка на хосте с дампами БД: <BACKUP_FOLDER>/<пул>_<YYYYMMDD-HHMMSS>.tar
BACKUP_FOLDER=/home/deploy/backups/dumps
# БД пула: контейнер <DB_CONTAINER_PREFIX><имя пула>, база и пользователь
DB_CONTAINER_PREFIX=postgresdb_
DB_NAME=CasePro_Test
DB_USER=postgres

# Для удаления пула: конфиги nginx и имя его контейнера
NGINX_CONFIG_FOLDER=/etc/nginx/conf.d
NGINX_CONTAINER_NAME=nginx
